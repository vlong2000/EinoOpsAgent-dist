# 大模型配置
MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 服务配置
SERVER_PORT=8080
SERVER_MODE=debug

# 知识库配置（可选）
KNOWLEDGE_BASE_PATH=./data/knowledge_base/

# 文件读取工具配置（只读 file-reader）
# 监控根目录，list_files/read_file/search_file 只能访问此目录内的相对路径
FILE_READER_WATCH_DIR=./data
# 每块最大字符数（按行累计切块）
FILE_READER_CHUNK_SIZE=30000
# search_file 单文件最多返回的匹配条数
FILE_READER_MAX_SEARCH_RESULTS=50

# 运维工具开关：false=只启用 list_files/read_file/search_file；true=额外启用网元状态、告警、ping、知识库
OPS_TOOLS_ENABLED=false
